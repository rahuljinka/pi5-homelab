# Display manager settings. Copy to .env and fill in; .env is never committed.
# Every value below is an example.

# Time zone for the screen schedule and the weather (tz database name).
TZ=America/Chicago

# Shown in the control panel's System Information.
PI_HOSTNAME=raspberrypi
PI_ADDRESS=192.168.0.10

# Where the data drive is mounted (OpenMediaVault mounts drives under /srv).
# Used only to show the drive's usage.
DATA_DISK=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000

# Weather screen location (decimal degrees) and the label shown on screen.
WEATHER_LATITUDE=41.8781
WEATHER_LONGITUDE=-87.6298
WEATHER_LOCATION_NAME=Chicago, IL
WEATHER_UNITS=fahrenheit

# Daily automatic screen switches, "HH:MM=screen" separated by commas.
# Screens: clock, weather, media. Leave empty for no schedule.
SCREEN_SCHEDULE=23:00=clock,12:00=weather

# Bluetooth LED strip controller's address (find it with: bluetoothctl scan le).
# Leave empty if there is no strip.
LED_STRIP_ADDRESS=AA:BB:CC:DD:EE:FF

# Govee Wi-Fi lights controlled over the LAN (turn on "LAN Control" in the
# Govee Home app), as "Name=ip;Name=ip". Leave empty if there are none.
GOVEE_LIGHTS=Table lamp=192.168.0.20

# Secret shared by the display's web server and the backend.
# Generate one with:  openssl rand -hex 24
DISPLAY_KEY=replace-with-a-random-value

# Control panel port on the network (optional).
# PANEL_PORT=3000

# Dev only: host names the dev panel and display accept besides localhost
# (comma-separated), e.g. the Pi's name and its Tailscale name.
# DEV_HOSTS=raspberrypi,raspberrypi.example.ts.net

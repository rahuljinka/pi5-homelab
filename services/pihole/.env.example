# Pi-hole settings. Copy to .env and fill in; .env is never committed.
TZ=America/Chicago
# Admin page password.
PIHOLE_PASSWORD=replace-with-a-strong-password
# Folder on the data drive for Pi-hole's settings and lists.
PIHOLE_DATA=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/appdata/pihole

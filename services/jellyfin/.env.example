# Jellyfin settings. Copy to .env and fill in; .env is never committed.
TZ=America/Chicago
# Jellyfin's own settings and metadata.
JELLYFIN_CONFIG=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/appdata/jellyfin
# Media folders.
JELLYFIN_MOVIES=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/media/movies
JELLYFIN_SHOWS=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/media/shows

# Immich settings. Copy to .env and fill in; .env is never committed.
# Every value below is an example. Docs: https://docs.immich.app/install/environment-variables

# Where uploaded photos and videos are stored (on the data drive).
UPLOAD_LOCATION=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/photos/immich-uploads

# Where the database files are stored. Must be a local disk, not a network share.
DB_DATA_LOCATION=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/appdata/immich/postgres

# Existing photo folder to index as an external library (mounted at /photos).
EXTERNAL_LIBRARY_LOCATION=/srv/dev-disk-by-uuid-00000000-0000-0000-0000-000000000000/photos/library

TZ=America/Chicago

# Pinned Immich release. Read the release notes before changing it.
IMMICH_VERSION=v3.0.3

# Database password: letters and numbers only. Generate: openssl rand -hex 16
DB_PASSWORD=replace-with-a-random-value

# These don't need changing.
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
